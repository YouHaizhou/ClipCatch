{
  "name": "video-ai-desktop",
  "version": "1.0.0",
  "description": "VideoAI Desktop - Electron App",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently \"pnpm -C ../frontend dev\" \"wait-on http://localhost:5173 -t 10000 && tsc && electron .\"",
    "build:win": "pnpm -C ../frontend build && tsc && electron-builder --win",
    "preview": "pnpm -C ../frontend preview"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "concurrently": "^8.2.2",
    "electron": "^33.4.11",
    "electron-builder": "^24.9.1",
    "typescript": "^5.3.3",
    "wait-on": "^7.2.0"
  }
}
